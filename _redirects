# Block common CMS / credential / scanner probes
/wp-login.php                 /404.html   404
/xmlrpc.php                   /404.html   404
/wp-admin/*                   /404.html   404
/wp-content/*                 /404.html   404
/wp-includes/*                /404.html   404
/wordpress/*                  /404.html   404
/wp/*                         /404.html   404

# Block exposed secret / repo / config probes
/.env                         /404.html   404
/.env.*                       /404.html   404
/.git/*                       /404.html   404
/.svn/*                       /404.html   404
/.hg/*                        /404.html   404
/.DS_Store                    /404.html   404
/composer.json                /404.html   404
/composer.lock                /404.html   404
/package-lock.json            /404.html   404
/yarn.lock                    /404.html   404
/pnpm-lock.yaml               /404.html   404
/server-status                /404.html   404
/phpinfo.php                  /404.html   404

# Optional: hide common backend guesses if your app has no API
/api/*                        /404.html   404
/admin/*                      /404.html   404
/login                        /404.html   404

# SPA fallback — keep last
/*                            /index.html 200
