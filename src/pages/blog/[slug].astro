---
import { getCollection, render } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const canonicalUrl = new URL(`/blog/${post.id}/`, Astro.site).toString();
const dateDisplay = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
}).format(post.data.date);
---

<BlogLayout
  title={`${post.data.title} — PilotCompatible`}
  description={post.data.description}
  canonicalUrl={canonicalUrl}
  ogType="article"
>
  <article class="post-article">
    <header class="post-header">
      <span class="post-category">{post.data.category}</span>
      <h1>{post.data.title}</h1>
      <div class="post-byline">
        <time datetime={post.data.date.toISOString()}>{dateDisplay}</time>
        <span class="post-reading-time">{post.data.readingTime}</span>
      </div>
    </header>
    <div class="post-body">
      <Content />
    </div>
  </article>
</BlogLayout>
