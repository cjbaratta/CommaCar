---
import { sanityClient } from "../../lib/sanity";
import { allPostsQuery } from "../../lib/queries";
import BlogLayout from "../../layouts/BlogLayout.astro";

const posts = await sanityClient.fetch(allPostsQuery);

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<BlogLayout
  title="Blog — PilotCompatible"
  description="openpilot installation guides, comparisons, and buyer's guides from the PilotCompatible team."
  canonicalUrl="https://www.pilotcompatible.com/blog/"
>
  <div class="blog-hero">
    <span class="eyebrow">Blog</span>
    <h1>openpilot Guides &amp; Resources</h1>
    <p>Installation walkthroughs, comparisons, and buyer's guides to help you get the most out of openpilot.</p>
  </div>

  <div class="blog-listing">
    {
      posts.map((post: any) => (
        <article class="post-card">
          <a href={`/blog/${post.slug}/`} class="post-card-link">
            <div class="post-card-meta">
              <span class="post-category">{post.category}</span>
              <span class="post-reading-time">{post.readingTime}</span>
            </div>
            <h2 class="post-card-title">{post.title}</h2>
            {post.description && <p class="post-card-excerpt">{post.description}</p>}
            <div class="post-card-footer">
              <time datetime={new Date(post.publishedAt).toISOString()}>{dateFormatter.format(new Date(post.publishedAt))}</time>
              <span class="post-card-cta">Read more →</span>
            </div>
          </a>
        </article>
      ))
    }
  </div>
</BlogLayout>
